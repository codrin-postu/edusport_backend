# EduSport Strapi backend — environment template.
#
# Copy to .env for local dev or to .env.production for the prod stack.
# Generate every secret with:  openssl rand -base64 32
# APP_KEYS expects a comma-separated list — generate two and join them.

# ----- Runtime -----
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# ----- Strapi secrets ----- (Generate: openssl rand -base64 32)
APP_KEYS=replace,replace
API_TOKEN_SALT=replace
ADMIN_JWT_SECRET=replace
TRANSFER_TOKEN_SALT=replace
JWT_SECRET=replace
ENCRYPTION_KEY=replace

# ----- Database -----
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace
DATABASE_SSL=false

# ----- CORS / frontend integration -----
# Comma-separated list of allowed origins for production.
FRONTEND_ORIGIN=https://scoaladepatinaj.com

# ----- On-demand revalidation ping (src/utils/revalidate.ts) -----
# Fired after every write to the "Meniu site" single type (promo overrides,
# pages on/off) so the frontend's cached menu/footer/sitemap don't wait out
# their TTL. Must match the frontend's own REVALIDATE_SECRET
# (see edusport_frontend/src/app/api/revalidate/route.ts). Unset in dev: the
# ping is then silently skipped.
REVALIDATE_SECRET=
# Base URL of the frontend to ping. Falls back to FRONTEND_ORIGIN when unset,
# so this only needs setting if the revalidate target differs from the CORS
# origin above.
REVALIDATE_FRONTEND_URL=

# ----- Google Sheets sync (all four public forms) -----
# Secrets only. Which spreadsheet each form writes to is stored in the database
# and edited from the admin "Google Sheets" settings page — no redeploy needed.
#
# Prerequisites in Google Cloud: enable the Sheets API AND the Drive API,
# create a service account, download its JSON key. The service account can only
# touch spreadsheets shared with its address.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Address that newly created spreadsheets are shared with (writer). Defaults to
# the admin who pressed "create" when unset.
SHEETS_SHARE_WITH=
# Set to 1 to simulate every Google call in memory and log what would happen.
SHEETS_DRY_RUN=
# Legacy: seeds the Înscrieri link on first boot if no link record exists yet.
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=

# Public address of this CMS (no trailing slash), e.g. https://cms.example.com.
# The Înscrieri Sheet's "Document" column links to the admin with it; unset,
# that column stays empty.
CMS_PUBLIC_URL=

# --- Dashboard "Sanatate site" card (self-hosted GlitchTip) ---
# The card answers one question for a non-technical operator: is the PUBLIC
# SITE working. So it reads one project, and that project is the frontend.
# Pointing it at edusport-backend fills the card with CMS-internal errors
# (upload permissions, policy rejections) that mean nothing to whoever is
# looking at it. Backend errors are still collected; they just belong in
# GlitchTip itself, not on this card.
GLITCHTIP_API_URL=
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=edusport-frontend
# Public origin, so the card's links work from a browser rather than pointing
# at the internal compose hostname.
GLITCHTIP_PUBLIC_URL=

# ----- Backend error tracking (src/sentry.ts) -----
# Sends this CMS's own server errors to the self-hosted GlitchTip instance
# (Sentry-API compatible), separate from the "Sanatate site" card above.
# Unset: entirely inert, server behaves identically.
SENTRY_DSN=
# Optional: override the reported environment (defaults to NODE_ENV) and the
# trace sample rate (defaults to 0.1).
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=

# ----- Registration PDFs (plan 2D) -----
# Signs the 24-hour download link on the registration success screen.
# Required in production (32+ characters): without it the form refuses
# registrations. Generate: openssl rand -base64 48
DOCUMENT_TOKEN_SECRET=
# Where the PDFs are stored. Leave empty in production: the default
# <app>/private/documents is the private_documents volume that
# scripts/backup.sh backs up.
PRIVATE_FILES_DIR=

# ----- E-mail (Brevo): registration e-mail, src/email/ -----
# Transactional API key (Brevo > SMTP & API > API keys). Unset: e-mails wait in
# the queue (email-job, status queued) and go out once a key is set. Nothing is lost.
BREVO_API_KEY=
# Sender: an address Brevo has verified, on a domain with Brevo SPF and DKIM.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Școala de Patinaj EduSport
# Optional reply-to, e.g. the club's inbox.
EMAIL_REPLY_TO=
# Real parents are e-mailed ONLY when NODE_ENV=production AND EMAIL_LIVE=true.
# Set EMAIL_LIVE=true in the VM's .env.production and nowhere else. Everywhere
# else every e-mail goes to EMAIL_TEST_RECIPIENT; without it, e-mails wait.
EMAIL_LIVE=
EMAIL_TEST_RECIPIENT=
# Links to the site ("Vezi programul", privacy) use the first FRONTEND_ORIGIN entry
# (above). The header image is CMS_PUBLIC_URL + /email/edusport-header.png
# (CMS_PUBLIC_URL is defined above for the Sheet links); unset, the header is text.
