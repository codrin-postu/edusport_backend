# EduSport Strapi backend — environment template.
#
# Copy to .env for local dev or to .env.production for the prod stack.
# Generate every secret with:  openssl rand -base64 32
# APP_KEYS expects a comma-separated list — generate two and join them.

# ----- Runtime -----
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# ----- Strapi secrets ----- (Generate: openssl rand -base64 32)
APP_KEYS=replace,replace
API_TOKEN_SALT=replace
ADMIN_JWT_SECRET=replace
TRANSFER_TOKEN_SALT=replace
JWT_SECRET=replace
ENCRYPTION_KEY=replace

# ----- Database -----
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace
DATABASE_SSL=false

# ----- CORS / frontend integration -----
# Comma-separated list of allowed origins for production.
FRONTEND_ORIGIN=https://scoaladepatinaj.com

# ----- Google Sheets sync (all four public forms) -----
# Secrets only. Which spreadsheet each form writes to is stored in the database
# and edited from the admin "Google Sheets" settings page — no redeploy needed.
#
# Prerequisites in Google Cloud: enable the Sheets API AND the Drive API,
# create a service account, download its JSON key. The service account can only
# touch spreadsheets shared with its address.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Address that newly created spreadsheets are shared with (writer). Defaults to
# the admin who pressed "create" when unset.
SHEETS_SHARE_WITH=
# Set to 1 to simulate every Google call in memory and log what would happen.
SHEETS_DRY_RUN=
# Legacy: seeds the Înscrieri link on first boot if no link record exists yet.
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=

# --- Dashboard "Sanatate site" card (self-hosted GlitchTip) ---
# The card answers one question for a non-technical operator: is the PUBLIC
# SITE working. So it reads one project, and that project is the frontend.
# Pointing it at edusport-backend fills the card with CMS-internal errors
# (upload permissions, policy rejections) that mean nothing to whoever is
# looking at it. Backend errors are still collected; they just belong in
# GlitchTip itself, not on this card.
GLITCHTIP_API_URL=
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=edusport-frontend
# Public origin, so the card's links work from a browser rather than pointing
# at the internal compose hostname.
GLITCHTIP_PUBLIC_URL=
