@startuml
!include _style.iuml
title Class diagram: registrations, documents, accounts
hide circle

class "RegistrationSubmission" as Reg <<changed>> {
  registrationNumber : string  // 2026-0142
  season, status, answers
  athlete : Athlete [0..1]  // set on confirm, cleared by undo, delete or a merge
  matchAthlete : Athlete [0..1] <<new>>  // saved match (2.1, 2.2); only while athlete is unset
  matchLevel : sigur | probabil <<new>>
  confirmation : ConfirmationRecord [0..1] <<new>>  // exactly what a confirmation wrote; cleared by undo/merge
}
class Athlete
class DocumentType {
  name : string
  source : generated | uploaded
  trigger : every registration | if member | manual
  attachTo : athlete | club
  hasBlankForm : bool
}
class Document {
  file : PDF/JPG/PNG
  version : int
  createdAt : datetime
}
class "PortalAccount" as Acc {
  email : string
  role : coach | parent
  status : invited | active | disabled
}
class "ParentAccess" as PA {
  status : invited | active
}
class "TeamMember" as Coach <<changed>>
class "HistoryEntry" as Hist {
  subject, action, by, at
}

Reg "0..*" -- "0..1" Athlete : confirmed as >
Document "0..*" -- "1" DocumentType
Document "0..*" -- "0..1" Athlete
Document "0..*" -- "0..1" Reg : generated from >
Acc "1" -- "0..*" PA
PA "0..*" -- "1" Athlete
Coach "1" -- "0..1" Acc : can log in >

note bottom of Hist
  Every edit, correction and move
  writes a HistoryEntry.
end note
note right of Reg
  ConfirmationRecord (json, stored on the registration;
  the undo plan reverts exactly this, nothing added since):
    athleteId, createdAthlete : bool
    previousStatus, athleteStatusBefore
    fieldsBefore, fieldsAfter : per-field values before/after
    membershipId : the membership this confirmation created
    promotedMainId, demotedMainId : memberships whose isMain
      this confirmation flipped (undo reverses both)
    acs : { id, previous } | null
    seasonId : the season whose group/A.C.S. this wrote to,
      null when none, absent on pre-3A rows (undo falls back
      to the season of membershipId/promotedMainId/demotedMainId)
    at
end note
legend bottom right
  Green «existing»: today, unchanged. Orange «changed»: today, gets new fields.
  Blue «new»: added in phase 3A+3B.
endlegend
@enduml
