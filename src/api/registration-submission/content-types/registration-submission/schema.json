{
  "kind": "collectionType",
  "collectionName": "registration_submissions",
  "info": {
    "singularName": "registration-submission",
    "pluralName": "registration-submissions",
    "displayName": "Înscrieri / Formular",
    "description": "Cereri de înscriere trimise prin formularul public de înscriere"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    }
  },
  "attributes": {
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "childName": {
      "type": "string",
      "required": true
    },
    "childBirthDate": {
      "type": "string",
      "required": true
    },
    "parentName": {
      "type": "string",
      "required": true
    },
    "shirtSize": {
      "type": "string",
      "required": true
    },
    "howHeard": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "priorExperience": {
      "type": "text"
    },
    "expectations": {
      "type": "text"
    },
    "clubInterest": {
      "type": "boolean",
      "default": false
    },
    "regulationsAgreement": {
      "type": "boolean",
      "default": false
    },
    "privacyConsent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": ["Nou", "Contactat", "Confirmat", "Respins"],
      "default": "Nou",
      "required": true
    },
    "internalNote": {
      "type": "text"
    },
    "submittedAt": {
      "type": "datetime"
    },
    "season": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "extra": {
      "type": "json"
    },
    "registrationNumber": { "type": "string", "unique": true, "column": { "unique": true } },
    "section": { "type": "relation", "relation": "manyToOne", "target": "api::section.section" },
    "seasonRef": { "type": "relation", "relation": "manyToOne", "target": "api::season.season" },
    "athlete": { "type": "relation", "relation": "manyToOne", "target": "api::athlete.athlete" },
    "relationship": { "type": "enumeration", "enum": ["parinte", "tutore", "alta"] },
    "relationshipOther": { "type": "string" },
    "childHeight": { "type": "integer" },
    "lastSeason": { "type": "string" },
    "membershipAnswer": { "type": "enumeration", "enum": ["da", "nu"] },
    "subscriptionChoice": { "type": "json" },
    "source": { "type": "string" },
    "sourceOther": { "type": "string" },
    "gdprConsent": { "type": "boolean" },
    "regulationsConsent": { "type": "boolean" }
  }
}
