{
  "kind": "collectionType",
  "collectionName": "competitions",
  "info": {
    "singularName": "competition",
    "pluralName": "competitions",
    "displayName": "Club / Competiție",
    "description": "Rezultate competiții pe sezoane"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "location": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "enum": ["national", "international"],
      "default": "national"
    },
    "season": {
      "type": "string",
      "required": true
    },
    "participantData": {
      "type": "json",
      "customField": "plugin::component-preview.participants-editor"
    },
    "sportspeople": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::sportsperson.sportsperson"
    }
  }
}
