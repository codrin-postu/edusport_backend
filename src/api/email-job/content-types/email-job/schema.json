{
  "kind": "collectionType",
  "collectionName": "email_jobs",
  "info": { "singularName": "email-job", "pluralName": "email-jobs", "displayName": "Club / E-mail" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": false } },
  "attributes": {
    "recipient": { "type": "string", "required": true },
    "subject": { "type": "string", "required": true },
    "kind": { "type": "enumeration", "enum": ["registration", "schedule-change"], "required": true, "default": "registration" },
    "registration": { "type": "relation", "relation": "manyToOne", "target": "api::registration-submission.registration-submission", "inversedBy": "emailJobs" },
    "status": { "type": "enumeration", "enum": ["queued", "sending", "sent", "failed", "cancelled"], "required": true, "default": "queued" },
    "attempts": { "type": "integer", "required": true, "default": 0, "min": 0 },
    "lastError": { "type": "text" },
    "sentAt": { "type": "datetime" },
    "group": { "type": "relation", "relation": "manyToOne", "target": "api::group.group" },
    "payload": { "type": "json" },
    "changeKey": { "type": "string" },
    "notBefore": { "type": "datetime" }
  }
}
