{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "Anunț",
    "description": "Anunțuri programate afișate pe site. Se administrează din pagina dedicată „Anunțuri”, nu din Content Manager."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "format": {
      "type": "enumeration",
      "enum": ["card", "modal"],
      "default": "card",
      "required": true
    },
    "ctaLabel": {
      "type": "string"
    },
    "ctaUrl": {
      "type": "string"
    },
    "startAt": {
      "type": "datetime",
      "required": true
    },
    "endAt": {
      "type": "datetime",
      "required": true
    },
    "priority": {
      "type": "integer",
      "default": 100
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "dismissDays": {
      "type": "integer",
      "default": 7
    }
  }
}
