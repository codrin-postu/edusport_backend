    "announcement": { "type": "relation", "relation": "manyToOne", "target": "api::announcement.announcement" },
    "key": { "type": "string" },
    "title": { "type": "string" },
    "rows": { "type": "json" },
    "athleteIds": { "type": "json" },
    "groupIds": { "type": "json" },
    "lastDate": { "type": "date" },
    "endedAt": { "type": "datetime" },
    "stoppedAt": { "type": "datetime" }
  }
