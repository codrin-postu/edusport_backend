{
  "collectionName": "components_calendar_exceptions",
  "info": {
    "displayName": "Excepție",
    "icon": "calendar",
    "description": "Anulează sau modifică o singură apariție a acestui eveniment"
  },
  "options": {
    "mainField": "date"
  },
  "attributes": {
    "date": { "type": "date", "required": true },
